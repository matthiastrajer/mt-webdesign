---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'datenschutz');
const { data } = entry!;
const { Content } = await entry!.render();
const base = import.meta.env.BASE_URL;
---

<Base title={`${data.title} — MTX-Webdesign`} description={data.metaDescription}>
  <Nav />
  <main class="legal">
    <div class="container">
      <span class="section-label">
        <span class="section-label__id">{data.labelId}</span>
        <span>{data.label}</span>
      </span>

      <div class="legal__body">
        {data.intro && <p class="eyebrow">{data.intro}</p>}
        <h1 class="legal__title">{data.title}</h1>

        <div class="legal__prose">
          <Content />
        </div>

        {data.warning && (
          <p class="legal__note mono">{data.warning}</p>
        )}

        <p class="legal__back">
          <a href={base} class="link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M19 12H5M11 18l-6-6 6-6"/>
            </svg>
            <span>Zurück zur Startseite</span>
          </a>
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    padding: clamp(4rem, 8vw, 7rem) 0;
    position: relative;
  }
  .legal__body {
    max-width: 720px;
    margin: 3rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .legal__title {
    font-size: clamp(2.25rem, 4vw + 1rem, 3.5rem);
    margin-top: 0.5rem;
  }
  .legal__prose :global(h2) {
    font-size: 1.15rem;
    margin: 1rem 0 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--line);
  }
  .legal__prose :global(h2:first-child) {
    padding-top: 0;
    border-top: none;
    margin-top: 0;
  }
  .legal__prose :global(p) {
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0 0 1rem;
  }
  .legal__prose :global(ul) {
    color: var(--ink-2);
    line-height: 1.7;
    padding-left: 1.25rem;
    margin: 0.5rem 0 1rem;
  }
  .legal__prose :global(li) {
    margin-bottom: 0.35rem;
  }
  .legal__prose :global(a) {
    color: var(--ink);
    border-bottom: 1px solid var(--brass);
  }
  .legal__prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .legal__note {
    background: var(--brass-tint);
    border-left: 2px solid var(--brass);
    padding: 1rem 1.25rem;
    color: var(--ink-2);
    font-size: 12px;
    margin-top: 2rem;
    line-height: 1.6;
    text-transform: none;
    letter-spacing: 0;
  }
  .legal__back {
    margin-top: 2rem;
  }
</style>
