---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import NewsHighlights from '../components/NewsHighlights.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="MTX-Webdesign — Webdesign in St. Pölten & Niederösterreich"
  description="Professionelle Websites für Unternehmen in Niederösterreich. Ihre neue Firmenwebsite in 14 Tagen live — inklusive Hosting, Admin-Panel zum Selbst-Pflegen und persönlicher Betreuung. Für Handwerk, Gastronomie, Praxen und Dienstleister."
>
  <Nav />
  <main>
    <Hero />
    <Services />
    <Process />
    <Faq />
    <NewsHighlights />
    <Contact />
  </main>
  <Footer />
</Base>
