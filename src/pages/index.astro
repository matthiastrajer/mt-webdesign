---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import NewsHighlights from '../components/NewsHighlights.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="MTX-Webdesign — Websites für kleine & mittlere Betriebe"
  description="Schnelle, moderne Websites für Handwerk, Handel, Gastronomie und Dienstleister. Website, Hosting und ein einfaches Admin-Panel zum Selbst-Pflegen — aus einer Hand."
>
  <Nav />
  <main>
    <Hero />
    <Services />
    <Process />
    <Faq />
    <NewsHighlights />
    <Contact />
  </main>
  <Footer />
</Base>
