---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import NewsHighlights from '../components/NewsHighlights.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';

// FAQPage-JSON-LD dynamisch aus der FAQ-Collection generieren.
// Google kann damit die Q&A als Rich Snippet direkt im Suchergebnis
// anzeigen — spürbarer Klickraten-Booster für Long-Tail-Suchen.
const faqEntry = await getEntry('faq', 'faq');
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntry!.data.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Base
  title="Webdesign St. Pölten & Niederösterreich | MTX-Webdesign"
  description="Professionelle Firmenwebsites für Unternehmen in St. Pölten & Niederösterreich. In 14 Tagen live, inklusive Hosting und Admin-Panel zum Selbst-Pflegen."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
    slot="head"
  />
  <Nav />
  <main>
    <Hero />
    <Services />
    <Process />
    <Faq />
    <NewsHighlights />
    <Contact />
  </main>
  <Footer />
</Base>
