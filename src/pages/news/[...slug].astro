---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const base = import.meta.env.BASE_URL;

const dateFmt = (d: Date) =>
  d.toLocaleDateString('de-AT', { day: '2-digit', month: 'long', year: 'numeric' });

// Titel-Länge fürs meta-Tag sanft absichern (max ~60 Zeichen inkl. Brand)
const brand = ' | MTX-Webdesign';
const maxTitleLen = 60 - brand.length;
const trimmedTitle = post.data.title.length > maxTitleLen
  ? post.data.title.slice(0, maxTitleLen - 1).trimEnd() + '…'
  : post.data.title;
const metaTitle = `${trimmedTitle}${brand}`;

// Cover-Bild absolut fürs OG-Tag; ohne Cover Fallback auf Favicon
const ogImagePath = post.data.cover ? `/news/${post.data.cover}` : '/favicon.png';
---

<Base
  title={metaTitle}
  description={post.data.excerpt}
  ogType="article"
  ogImage={ogImagePath}
  ogImageAlt={post.data.coverAlt ?? post.data.title}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'News', url: '/news/' },
    { name: post.data.title, url: `/news/${post.slug}/` },
  ]}
  article={{
    publishedTime: post.data.date.toISOString(),
  }}
>
  <Nav />

  <main class="article">
    <div class="container article__inner">
      <a href={`${base}news/`} class="link article__back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6"/>
        </svg>
        <span>Alle News</span>
      </a>

      <header class="article__header">
        <time class="mono article__date" datetime={post.data.date.toISOString()}>
          {dateFmt(post.data.date)}
        </time>
        <h1 class="article__title">{post.data.title}</h1>
        <p class="lead article__lead">{post.data.excerpt}</p>
      </header>

      {post.data.cover && (
        <figure class="article__cover">
          <img
            src={`${base}news/${post.data.cover}`}
            alt={post.data.coverAlt ?? ''}
          />
        </figure>
      )}

      <article class="article__body prose">
        <Content />
      </article>

      <footer class="article__footer">
        <a href={`${base}news/`} class="link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6"/>
          </svg>
          <span>Zurück zur Übersicht</span>
        </a>
      </footer>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .article {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(4rem, 8vw, 6rem);
  }

  .article__inner {
    max-width: 720px;
  }

  .article__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .article__header {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .article__date {
    color: var(--brass);
    letter-spacing: 0.1em;
    font-size: 11px;
    text-transform: uppercase;
  }

  .article__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw + 1rem, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
  }

  .article__lead {
    margin: 0;
  }

  .article__cover {
    margin: 0 0 2.5rem;
  }

  .article__cover img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--line);
  }

  .article__body {
    color: var(--ink);
    font-size: 16.5px;
    line-height: 1.7;
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 2.5rem 0 0.75rem;
    line-height: 1.25;
  }

  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 2rem 0 0.5rem;
  }

  .prose :global(p) {
    margin: 0 0 1.15rem;
    color: var(--ink-2);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
    color: var(--ink-2);
  }

  .prose :global(li) {
    margin-bottom: 0.35rem;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--ink);
    border-bottom: 1px solid var(--brass);
    transition: color var(--dur) var(--ease-out);
  }

  .prose :global(a:hover) {
    color: var(--brass);
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.5rem 0 0.5rem 1.25rem;
    border-left: 3px solid var(--brass);
    color: var(--ink-2);
    font-style: italic;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: color-mix(in srgb, var(--paper) 40%, var(--paper-2));
    padding: 0.1em 0.4em;
    border-radius: 2px;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
    margin: 1.5rem 0;
  }

  .article__footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
</style>
