---
import '../styles/global.css';

// Self-hosted fonts — kein Google-CDN, kein Datentransfer an Dritte
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

interface Breadcrumb {
  name: string;
  url: string;
}

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
}

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  breadcrumbs?: Breadcrumb[];
  article?: ArticleMeta;
}

const SITE_NAME = 'MTX-Webdesign';
const AUTHOR = 'Matthias Trajer';
const DEFAULT_DESCRIPTION =
  'Webdesign St. Pölten & Niederösterreich: professionelle Firmenwebsites, Hosting und Admin-Panel zum Selbst-Pflegen — aus einer Hand. In 14 Tagen live.';
const DEFAULT_OG_ALT =
  'MTX-Webdesign — Webdesign in St. Pölten & Niederösterreich';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  noindex = false,
  ogType = 'website',
  ogImage = '/favicon.png',
  ogImageAlt = DEFAULT_OG_ALT,
  breadcrumbs,
  article,
} = Astro.props;

// ---------------------------------------------------------------
// Canonical: immer auf die produktive Zieldomain (mtx-webdesign.at)
// zeigen — auch wenn die Seite gerade noch auf github.io läuft. Sobald
// die Custom-Domain live ist, greifen alle Signale konsistent.
// ---------------------------------------------------------------
const rawBase = import.meta.env.BASE_URL; // z. B. "/mt-webdesign/" oder "/"
const pathname = Astro.url.pathname.startsWith(rawBase)
  ? '/' + Astro.url.pathname.slice(rawBase.length)
  : Astro.url.pathname;
const cleanPath = pathname.replace(/\/+$/, '/') || '/';
const canonicalURL = new URL(cleanPath, Astro.site).href;

const absoluteOgImage = new URL(ogImage, Astro.site).href;

// ---------------------------------------------------------------
// JSON-LD @graph — Organization + WebSite + Logo + LocalBusiness,
// optional erweitert um BreadcrumbList (pro Seite) und Article
// (auf News-Detail-Seiten). Single-Graph-Ansatz ist Google-empfohlen,
// weil sich die Nodes über @id referenzieren lassen.
// ---------------------------------------------------------------
const siteHref = Astro.site!.href;

const orgNode = {
  '@type': 'Organization',
  '@id': `${siteHref}#organization`,
  name: SITE_NAME,
  url: siteHref,
  logo: { '@id': `${siteHref}#logo` },
  image: { '@id': `${siteHref}#logo` },
  email: 'hallo@mtx-webdesign.at',
  founder: { '@type': 'Person', name: AUTHOR },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      email: 'hallo@mtx-webdesign.at',
      contactType: 'customer service',
      availableLanguage: ['de', 'de-AT'],
      areaServed: 'AT',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kokoschkagasse 6d',
    postalCode: '3104',
    addressLocality: 'St. Pölten',
    addressRegion: 'Niederösterreich',
    addressCountry: 'AT',
  },
};

const websiteNode = {
  '@type': 'WebSite',
  '@id': `${siteHref}#website`,
  url: siteHref,
  name: SITE_NAME,
  inLanguage: 'de-AT',
  publisher: { '@id': `${siteHref}#organization` },
};

const logoNode = {
  '@type': 'ImageObject',
  '@id': `${siteHref}#logo`,
  url: `${siteHref}favicon.png`,
  contentUrl: `${siteHref}favicon.png`,
  caption: SITE_NAME,
  width: 1254,
  height: 1254,
};

const localBusinessNode = {
  '@type': 'ProfessionalService',
  '@id': `${siteHref}#localbusiness`,
  name: SITE_NAME,
  description:
    'Webdesign-Agentur in St. Pölten und Niederösterreich. Professionelle Websites für kleine und mittlere Unternehmen.',
  url: siteHref,
  email: 'hallo@mtx-webdesign.at',
  image: { '@id': `${siteHref}#logo` },
  logo: { '@id': `${siteHref}#logo` },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kokoschkagasse 6d',
    postalCode: '3104',
    addressLocality: 'St. Pölten',
    addressRegion: 'Niederösterreich',
    addressCountry: 'AT',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 48.2047,
    longitude: 15.6256,
  },
  areaServed: [
    { '@type': 'City', name: 'St. Pölten' },
    { '@type': 'AdministrativeArea', name: 'Niederösterreich' },
    { '@type': 'City', name: 'Wien' },
  ],
  priceRange: '€€',
  founder: { '@type': 'Person', name: AUTHOR },
};

const graph: unknown[] = [orgNode, websiteNode, logoNode, localBusinessNode];

if (breadcrumbs && breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: b.url.startsWith('http')
        ? b.url
        : new URL(b.url.replace(/^\//, ''), Astro.site).href,
    })),
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<!doctype html>
<html lang="de-AT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef1f4" />

    <!-- Autorenschaft -->
    <meta name="author" content={AUTHOR} />
    <meta name="creator" content={AUTHOR} />
    <meta name="publisher" content={SITE_NAME} />
    <meta name="referrer" content="no-referrer-when-downgrade" />

    <!-- Robots: explizit auch für erlaubte Seiten (max-image-preview:large
         schaltet große Vorschaubilder in Google-Discover frei) -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
    )}

    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon: PNG (Brand-Logo, MTX-Marke) -->
    <link rel="icon" type="image/png" href={`${rawBase}favicon.png`} />
    <link rel="apple-touch-icon" href={`${rawBase}favicon.png`} />

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime} />
    )}
    {ogType === 'article' && (
      <meta property="article:author" content={AUTHOR} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <title>{title}</title>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    ></script>

    <!-- Slot für seitenspezifisches JSON-LD (z. B. FAQPage auf der Home) -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <slot />

    <!-- ============ Cookie-/Consent-Banner ============
         Google Analytics ist DSGVO-relevant und darf nur nach ausdrücklicher
         Einwilligung geladen werden. Der Banner erscheint solange keine
         Entscheidung im localStorage steht; auf „Akzeptieren" wird gtag
         dynamisch nachgeladen, auf „Ablehnen" passiert nichts. Der
         Datenschutz-Seite liegt ein Widerruf-Button bei. -->
    <div id="consent-banner" class="consent-banner" hidden aria-live="polite" aria-label="Cookie-Hinweis">
      <div class="consent-banner__inner">
        <p class="consent-banner__text">
          Diese Website nutzt <strong>Google Analytics</strong> zur anonymen
          Reichweitenmessung, damit ich die Seite verbessern kann. Es werden
          Cookies gesetzt und Daten an Google übertragen (auch in die USA).
          Details in der <a href={`${rawBase}datenschutz/`} class="consent-banner__link">Datenschutzerklärung</a>.
        </p>
        <div class="consent-banner__actions">
          <button type="button" class="consent-btn consent-btn--secondary" data-consent="denied">Ablehnen</button>
          <button type="button" class="consent-btn consent-btn--primary" data-consent="granted">Akzeptieren</button>
        </div>
      </div>
    </div>

    <script>
      (function () {
        const GA_ID = 'G-R2YSDT5ZJY';
        const KEY = 'mtx-consent-v1';
        const banner = document.getElementById('consent-banner');

        function loadGA() {
          if ((window as any).gtag) return;
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
          (window as any).dataLayer = (window as any).dataLayer || [];
          (window as any).gtag = function () { (window as any).dataLayer.push(arguments); };
          (window as any).gtag('js', new Date());
          (window as any).gtag('config', GA_ID, { anonymize_ip: true });
        }

        function setConsent(state: string) {
          try { localStorage.setItem(KEY, state); } catch {}
          if (banner) (banner as HTMLElement).hidden = true;
          if (state === 'granted') loadGA();
        }

        let current: string | null = null;
        try { current = localStorage.getItem(KEY); } catch {}

        if (current === 'granted') {
          loadGA();
        } else if (current !== 'denied' && banner) {
          (banner as HTMLElement).hidden = false;
        }

        banner?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((btn) => {
          btn.addEventListener('click', () => setConsent(btn.dataset.consent || 'denied'));
        });

        // Global Widerruf-Funktion — von der Datenschutz-Seite aus aufrufbar
        (window as any).__mtxRevokeConsent = function () {
          try { localStorage.removeItem(KEY); } catch {}
          location.reload();
        };
      })();
    </script>

    <script>
      // Scroll-Reveal: leichtgewichtig, respektiert reduced-motion
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).dataset.visible = 'true';
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else {
        document
          .querySelectorAll<HTMLElement>('.reveal')
          .forEach((el) => (el.dataset.visible = 'true'));
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--paper);
        padding: 0.75rem 1rem;
        z-index: 100;
      }
      .skip-link:focus {
        left: 0;
      }

      /* ============ Cookie-Consent-Banner ============ */
      .consent-banner {
        position: fixed;
        left: 1rem;
        right: 1rem;
        bottom: 1rem;
        z-index: 90;
        background: var(--paper, #fdfcf9);
        border: 1px solid var(--line-strong, #b8b3a9);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
        border-radius: 4px;
        max-width: 720px;
        margin: 0 auto;
        animation: consent-slide-up 0.32s cubic-bezier(0.16, 1, 0.3, 1);
      }

      @keyframes consent-slide-up {
        from { transform: translateY(24px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }

      .consent-banner[hidden] {
        display: none;
      }

      .consent-banner__inner {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding: 1rem 1.25rem;
      }

      .consent-banner__text {
        margin: 0;
        font-size: 14px;
        line-height: 1.5;
        color: var(--ink-2, #4a4a4a);
        flex: 1;
      }

      .consent-banner__text strong {
        color: var(--ink, #1a1a1a);
        font-weight: 600;
      }

      .consent-banner__link {
        color: var(--brass, #c7913f);
        text-decoration: underline;
        text-decoration-color: color-mix(in srgb, var(--brass, #c7913f) 40%, transparent);
        text-underline-offset: 2px;
      }

      .consent-banner__link:hover {
        text-decoration-color: var(--brass, #c7913f);
      }

      .consent-banner__actions {
        display: flex;
        gap: 0.5rem;
        flex-shrink: 0;
      }

      .consent-btn {
        font-family: var(--font-display, inherit);
        font-size: 14px;
        font-weight: 500;
        padding: 0.55rem 1.15rem;
        border-radius: 2px;
        cursor: pointer;
        border: 1px solid transparent;
        transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
      }

      .consent-btn--primary {
        background: var(--ink, #1a1a1a);
        color: var(--paper, #fdfcf9);
      }

      .consent-btn--primary:hover {
        background: var(--brass, #c7913f);
      }

      .consent-btn--secondary {
        background: transparent;
        border-color: var(--line-strong, #b8b3a9);
        color: var(--ink-2, #4a4a4a);
      }

      .consent-btn--secondary:hover {
        border-color: var(--ink, #1a1a1a);
        color: var(--ink, #1a1a1a);
      }

      @media (max-width: 620px) {
        .consent-banner__inner {
          flex-direction: column;
          align-items: stretch;
          gap: 0.85rem;
        }
        .consent-banner__actions {
          justify-content: flex-end;
        }
      }
    </style>
  </body>
</html>
