---
import '../styles/global.css';

// Self-hosted fonts — kein Google-CDN, kein Datentransfer an Dritte
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'MTX-Webdesign — schnelle, moderne Websites für kleine und mittlere Betriebe. Website, Hosting und ein einfaches Admin-Panel zum Selbst-Pflegen — aus einer Hand.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef1f4" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Favicon: PNG (Brand-Logo, MTX-Marke) -->
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.png`} />

    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <slot />

    <script>
      // Scroll-Reveal: leichtgewichtig, respektiert reduced-motion
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).dataset.visible = 'true';
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else {
        document
          .querySelectorAll<HTMLElement>('.reveal')
          .forEach((el) => (el.dataset.visible = 'true'));
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--paper);
        padding: 0.75rem 1rem;
        z-index: 100;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
