---
import '../styles/global.css';

// Self-hosted fonts — kein Google-CDN, kein Datentransfer an Dritte
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'MTX-Webdesign — Webdesign in St. Pölten & Niederösterreich. Professionelle Websites für kleine und mittlere Betriebe: Website + Hosting + Admin-Panel zum Selbst-Pflegen, aus einer Hand.',
  noindex = false,
} = Astro.props;

// Strukturierte Daten für lokale Google-Rankings (Schema.org LocalBusiness).
// Signalisiert Google: „Das hier ist ein echtes lokales Unternehmen mit
// Standort in St. Pölten, das Webdesign-Dienstleistungen anbietet."
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'MTX-Webdesign',
  description:
    'Webdesign-Agentur in St. Pölten und Niederösterreich. Professionelle Websites für kleine und mittlere Unternehmen.',
  url: 'https://mtx-webdesign.at',
  email: 'hallo@mtx-webdesign.at',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kokoschkagasse 6d',
    postalCode: '3104',
    addressLocality: 'St. Pölten',
    addressRegion: 'Niederösterreich',
    addressCountry: 'AT',
  },
  areaServed: [
    { '@type': 'City', name: 'St. Pölten' },
    { '@type': 'AdministrativeArea', name: 'Niederösterreich' },
    { '@type': 'City', name: 'Wien' },
  ],
  priceRange: '€€',
  founder: {
    '@type': 'Person',
    name: 'Matthias Trajer',
  },
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef1f4" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Favicon: PNG (Brand-Logo, MTX-Marke) -->
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.png`} />

    <!-- Open Graph & Twitter Card für schönere Vorschauen bei Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_AT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusiness)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <slot />

    <script>
      // Scroll-Reveal: leichtgewichtig, respektiert reduced-motion
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).dataset.visible = 'true';
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else {
        document
          .querySelectorAll<HTMLElement>('.reveal')
          .forEach((el) => (el.dataset.visible = 'true'));
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--paper);
        padding: 0.75rem 1rem;
        z-index: 100;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
