---
import { getEntry } from 'astro:content';

const entry = await getEntry('faq', 'faq');
const f = entry!.data;
const faq = f.items;
const base = import.meta.env.BASE_URL;
---

<section class="section faq-section" id="faq">
  <div class="container">
    <span class="section-label">
      <span class="section-label__id">004</span>
      <span>Häufig gefragt</span>
    </span>

    <header class="faq-header reveal">
      <p class="eyebrow">{f.eyebrow}</p>
      <h2>{f.heading}</h2>
      <p class="lead">{f.lead}</p>
    </header>

    <div class="faq__list">
      {
        faq.map((item, i) => (
          <details class="faq__item reveal" open={i === 0}>
            <summary class="faq__question">
              <span class="mono faq__n">Q · 0{i + 1}</span>
              <span class="faq__q-text">{item.q}</span>
              <span class="faq__icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 5v14M5 12h14"/>
                </svg>
              </span>
            </summary>
            <div class="faq__answer">
              <p set:html={item.a}></p>
            </div>
          </details>
        ))
      }
    </div>

    <div class="faq__cta reveal">
      <p class="mono faq__cta-mono">{f.ctaLead}</p>
      <a href={`${base}#kontakt`} class="link">
        <span>{f.ctaText}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .faq-header {
    max-width: 720px;
    margin: 3rem 0 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
    transition: background var(--dur) var(--ease-out);
  }

  .faq__item[open] {
    background: color-mix(in srgb, var(--paper) 55%, var(--paper-2));
  }

  .faq__question {
    padding: 1.4rem 1rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
    transition: color var(--dur) var(--ease-out);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    color: var(--brass-text);
  }

  .faq__n {
    color: var(--brass-text);
    letter-spacing: 0.1em;
    font-size: 11px;
    min-width: 44px;
  }

  .faq__q-text {
    flex: 1;
  }

  .faq__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
    border-radius: 2px;
    transition: transform var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
    flex-shrink: 0;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    border-color: var(--brass-text);
    background: var(--brass);
    color: var(--paper);
  }

  .faq__answer {
    padding: 0 1rem 1.75rem;
    padding-left: calc(44px + 2.5rem);
    max-width: 78ch;
  }

  .faq__answer p {
    color: var(--ink-2);
    line-height: 1.65;
    font-size: 15.5px;
  }

  .faq__answer :global(.faq__link) {
    color: var(--brass-text);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 40%, transparent);
    transition: border-color var(--dur) var(--ease-out);
  }

  .faq__answer :global(.faq__link:hover) {
    border-bottom-color: var(--brass-text);
  }

  .faq__cta {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px dashed var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .faq__cta-mono {
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  @media (max-width: 620px) {
    .faq__question {
      grid-template-columns: 1fr auto;
      gap: 1rem;
      padding: 1.2rem 0.75rem;
    }
    .faq__n {
      grid-column: 1 / -1;
      min-width: 0;
    }
    .faq__answer {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }
</style>
