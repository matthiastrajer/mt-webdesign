---
import { getEntry } from 'astro:content';

const entry = await getEntry('process', 'process');
const p = entry!.data;
const steps = p.steps;
---

<section class="section process" id="ablauf">
  <div class="container">
    <span class="section-label">
      <span class="section-label__id">003</span>
      <span>Ablauf</span>
    </span>

    <div class="process__intro">
      <header class="process__header reveal">
        <p class="eyebrow">{p.eyebrow}</p>
        <h2>{p.heading}</h2>
        <p class="lead">{p.lead}</p>
      </header>

      {p.image && (
        <figure class="process__photo reveal reveal--delay-1">
          <picture>
            {p.image.endsWith('.jpg') && (
              <source srcset={p.image.replace(/\.jpg$/, '.webp')} type="image/webp" />
            )}
            <img
              src={p.image}
              alt={p.imageAlt ?? ''}
              width="840"
              height="560"
              loading="lazy"
            />
          </picture>
        </figure>
      )}
    </div>

    <ol class="process__list">
      {
        steps.map((step, i) => (
          <li class={`step reveal reveal--delay-${(i % 4) + 1}`}>
            <div class="step__marker">
              <span class="step__n">{step.n}</span>
              <span class="step__connector" aria-hidden="true" />
            </div>
            <div class="step__content">
              <div class="step__meta">
                <h3 class="step__title">{step.title}</h3>
                <span class="mono step__duration">{step.duration}</span>
              </div>
              <p class="step__body" set:html={step.body}></p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process__intro {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    /* padding-top statt margin-top: ein margin würde hier durch
       .container kollabieren (kein padding-top/border dort, und
       .section-label blockiert das Kollabieren nicht, weil es
       position:absolute ist) — der Abstand zum "003 Ablauf"-Label
       wäre dann lautlos weg. padding kollabiert nie. Selbes Muster
       wie der Fix in Contact.astro (.contact__grid). */
    padding-top: 3rem;
    margin-bottom: 4rem;
  }

  .process__header {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .process__photo {
    margin: 0;
    position: relative;
  }

  .process__photo picture {
    display: block;
    position: relative;
    border: 1px solid var(--line);
  }

  .process__photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Messing-Eckmarken, gleiches Muster wie .contact__form/.contact__success */
  .process__photo picture::before,
  .process__photo picture::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--brass-text);
    border-style: solid;
    border-width: 0;
    pointer-events: none;
  }

  .process__photo picture::before {
    top: -1px;
    left: -1px;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .process__photo picture::after {
    bottom: -1px;
    right: -1px;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  @media (max-width: 900px) {
    .process__intro {
      grid-template-columns: 1fr;
    }
    .process__photo {
      max-width: 420px;
    }
  }

  .process__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .step {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 2rem 0;
    border-top: 1px solid var(--line);
    position: relative;
  }

  .step:last-child {
    border-bottom: 1px solid var(--line);
  }

  .step__marker {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
  }

  .step__n {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1;
    letter-spacing: -0.04em;
    position: relative;
    padding-right: 0.75rem;
    border-right: 1px solid var(--brass);
  }

  .step__connector {
    display: none;
  }

  .step__content {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-top: 0.25rem;
  }

  .step__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
  }

  .step__title {
    font-size: clamp(1.35rem, 1vw + 1rem, 1.75rem);
  }

  .step__duration {
    color: var(--brass-text);
    letter-spacing: 0.06em;
  }

  .step__body {
    color: var(--ink-2);
    max-width: 65ch;
    font-size: 15.5px;
    line-height: 1.6;
  }

  .step__body :global(.step__link) {
    color: var(--brass-text);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 40%, transparent);
    transition: border-color var(--dur) var(--ease-out);
  }

  .step__body :global(.step__link:hover) {
    border-bottom-color: var(--brass-text);
  }

  @media (max-width: 600px) {
    .step {
      grid-template-columns: 64px 1fr;
    }
    .step__n {
      font-size: 2rem;
    }
  }
</style>
