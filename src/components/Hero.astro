---
import { getEntry } from 'astro:content';

const entry = await getEntry('hero', 'hero');
const h = entry!.data;
const base = import.meta.env.BASE_URL;
---

<section class="hero" id="main">
  <div class="hero__grid" aria-hidden="true"></div>

  <div class="container hero__inner">
    <!-- Bemaßungs-Label oben -->
    <div class="hero__topline">
      <span class="mono hero__coord">{h.coord}</span>
      <span class="dim">
        <span class="dim__arrow">◀</span>
        {h.dimensions.map((d, i) => (
          <>
            <span>{d}</span>
            {i < h.dimensions.length - 1 && <span class="dim__arrow">·</span>}
          </>
        ))}
        <span class="dim__arrow">▶</span>
      </span>
    </div>

    <div class="hero__body">
      <p class="eyebrow load-in load-in--1">{h.eyebrow}</p>

      <h1 class="hero__headline">
        <span class="load-in load-in--2">{h.headlineLead}</span><br />
        <span class="load-in load-in--3">{h.headlineMain}{' '}<em class="hero__em">{h.headlineHighlight}</em>.</span>
      </h1>

      <p class="lead hero__lead load-in load-in--4">{h.lead}</p>

      <div class="hero__cta load-in load-in--5">
        <a href={`${base}#kontakt`} class="btn">
          <span>{h.ctaText}</span>
          <svg class="btn__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
        <a href={`${base}#leistungen`} class="link">
          <span>{h.secondaryLinkText}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Untere Bemaßungslinie -->
    <div class="hero__dim">
      <div class="dim-line draw-line"></div>
      <div class="hero__dim-labels">
        <span class="mono">{h.dimLeft}</span>
        <span class="mono">{h.dimRight}</span>
      </div>
    </div>

    <!-- Passt-für-Zeile -->
    <div class="hero__trust load-in load-in--5">
      <span class="mono">{h.trustLabel}</span>
      <div class="hero__trust-list">
        {h.trustList.map((item, i) => (
          <>
            <span>{item}</span>
            {i < h.trustList.length - 1 && <span aria-hidden="true">·</span>}
          </>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(1rem, 2.5vw, 2rem) 0 clamp(3rem, 6vw, 5rem);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(500px 320px at 85% 30%, var(--brass-tint), transparent 70%),
      linear-gradient(180deg, transparent 0%, var(--paper) 90%);
    pointer-events: none;
    z-index: 0;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.25rem;
    border-bottom: 1px dashed var(--line);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__coord {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--brass-text);
    letter-spacing: 0.1em;
  }

  .hero__body {
    max-width: 900px;
  }

  .hero__headline {
    margin-top: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .hero__em {
    font-style: normal;
    color: var(--brass-display);
    position: relative;
    display: inline-block;
  }

  .hero__em::after {
    content: '';
    position: absolute;
    bottom: 0.08em;
    left: 0;
    right: 0;
    height: 0.08em;
    background: var(--brass);
    opacity: 0.35;
  }

  .hero__lead {
    margin-bottom: 2.25rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .hero__dim {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  .hero__dim-labels {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hero__dim-labels .mono {
    color: var(--ink-3);
  }

  .hero__trust {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .hero__trust-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--ink-2);
    letter-spacing: -0.005em;
  }

  .hero__trust-list span[aria-hidden] {
    color: var(--line-strong);
  }

  @media (max-width: 640px) {
    .hero__topline {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .hero__dim-labels {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
