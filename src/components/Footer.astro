---
import { getEntry } from 'astro:content';

const year = new Date().getFullYear();
const footerEntry = await getEntry('footer', 'footer');
const f = footerEntry!.data;
const settingsEntry = await getEntry('settings', 'site');
const s = settingsEntry!.data;
const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href={base} class="footer__logo" aria-label="MTX-Webdesign Startseite">
          <img src={`${base}brand/mtx-logo.png`} alt="MTX-Webdesign" class="footer__logo-img" />
        </a>
        <p class="footer__tag">{f.tagline}</p>
      </div>

      <div class="footer__meta">
        <div class="footer__col">
          <span class="mono footer__label">Kontakt</span>
          <a href={`mailto:${s.email}`}>{s.email}</a>
        </div>

        <div class="footer__col">
          <span class="mono footer__label">Rechtliches</span>
          <a href={`${base}impressum/`}>Impressum</a>
          <a href={`${base}datenschutz/`}>Datenschutz</a>
        </div>

        <div class="footer__col">
          <span class="mono footer__label">Standort</span>
          <span>{s.addressStreet}</span>
          <span>{s.addressCity} · AT</span>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <div class="dim-line"></div>
      <div class="footer__row">
        <span class="mono">© {year} · {s.company} · {s.ownerName}</span>
        <div class="footer__row-right">
          <span class="mono">{f.creditText}</span>
          <a href={`${base}admin/`} class="mono footer__admin" rel="nofollow">
            <span aria-hidden="true">·</span>
            <span>Admin-Login</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 4rem 0 2rem;
    background: color-mix(in srgb, var(--paper) 40%, var(--paper-2));
    position: relative;
    z-index: 1;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: 3rem;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 320px;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
  }

  .footer__logo-img {
    display: block;
    height: 60px;
    width: auto;
    object-fit: contain;
  }

  .footer__tag {
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.55;
  }

  .footer__meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 14px;
  }

  .footer__col a,
  .footer__col span:not(.mono) {
    color: var(--ink);
    transition: color var(--dur) var(--ease-out);
  }

  .footer__col a:hover {
    color: var(--brass);
  }

  .footer__label {
    color: var(--ink-3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 10.5px;
    margin-bottom: 0.35rem;
  }

  .footer__bottom {
    padding-top: 1.5rem;
  }

  .footer__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .footer__row .mono {
    color: var(--ink-3);
    font-size: 11px;
  }

  .footer__row-right {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer__admin {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-3);
    font-size: 11px;
    transition: color var(--dur) var(--ease-out);
  }

  .footer__admin:hover {
    color: var(--brass);
  }

  @media (max-width: 780px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
    .footer__meta {
      grid-template-columns: repeat(2, 1fr);
    }
    .footer__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .footer__meta {
      grid-template-columns: 1fr;
    }
  }
</style>
