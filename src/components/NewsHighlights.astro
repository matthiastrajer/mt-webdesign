---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const dateFmt = (d: Date) =>
  d.toLocaleDateString('de-AT', { day: '2-digit', month: 'short', year: 'numeric' });
---

{posts.length > 0 && (
  <section class="section news-highlights" id="news">
    <div class="container">
      <span class="section-label">
        <span class="section-label__id">006</span>
        <span>News</span>
      </span>

      <header class="news-highlights__header reveal">
        <div>
          <p class="eyebrow">Aktuelles</p>
          <h2>Neueste Beiträge.</h2>
        </div>
        <a href={`${base}news/`} class="link news-highlights__all">
          <span>Alle News anzeigen</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </header>

      <ol class="news-slides reveal reveal--delay-1">
        {posts.map((post) => (
          <li class="news-slide">
            <a href={`${base}news/${post.slug}`} class="news-slide__link">
              <div class="news-slide__media">
                {post.data.cover ? (
                  <img
                    src={`${base}news/${post.data.cover}`}
                    alt={post.data.coverAlt ?? ''}
                    loading="lazy"
                  />
                ) : (
                  <div class="news-slide__media-fallback" aria-hidden="true">
                    <span class="mono">MT · N</span>
                  </div>
                )}
              </div>
              <div class="news-slide__body">
                <time class="mono news-slide__date" datetime={post.data.date.toISOString()}>
                  {dateFmt(post.data.date)}
                </time>
                <h3 class="news-slide__title">{post.data.title}</h3>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <a href={`${base}news/`} class="link news-highlights__all news-highlights__all--mobile">
        <span>Alle News anzeigen</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>
  </section>
)}

<style>
  .news-highlights__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin: 3rem 0 2.5rem;
  }

  .news-highlights__header h2 {
    margin: 0.25rem 0 0;
  }

  .news-highlights__all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: gap var(--dur) var(--ease-out);
  }

  .news-highlights__all:hover {
    gap: 0.75rem;
  }

  .news-highlights__all--mobile {
    display: none;
    margin-top: 1.75rem;
  }

  .news-slides {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .news-slide {
    background: var(--paper);
    border: 1px solid var(--line);
    transition: border-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
    position: relative;
  }

  .news-slide::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 12px;
    height: 12px;
    border-top: 1px solid transparent;
    border-left: 1px solid transparent;
    transition: border-color var(--dur) var(--ease-out);
  }

  .news-slide:hover {
    border-color: var(--brass);
    transform: translateY(-3px);
  }

  .news-slide:hover::before {
    border-top-color: var(--brass);
    border-left-color: var(--brass);
  }

  .news-slide__link {
    display: flex;
    flex-direction: column;
    color: inherit;
    height: 100%;
  }

  .news-slide__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: color-mix(in srgb, var(--paper) 40%, var(--paper-2));
  }

  .news-slide__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms var(--ease-out);
  }

  .news-slide:hover .news-slide__media img {
    transform: scale(1.03);
  }

  .news-slide__media-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: var(--brass);
    font-size: 12px;
    letter-spacing: 0.15em;
  }

  .news-slide__body {
    padding: 1.25rem 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }

  .news-slide__date {
    color: var(--brass);
    letter-spacing: 0.08em;
    font-size: 11px;
    text-transform: uppercase;
  }

  .news-slide__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0;
    color: var(--ink);
  }

  /* Tablet: 2 Spalten, dritte darunter */
  @media (max-width: 900px) {
    .news-slides {
      grid-template-columns: 1fr 1fr;
    }
    .news-slide:nth-child(3) {
      grid-column: 1 / -1;
      display: block;
    }
    .news-slide:nth-child(3) .news-slide__link {
      display: grid;
      grid-template-columns: 260px 1fr;
    }
    .news-slide:nth-child(3) .news-slide__media {
      aspect-ratio: 4 / 3;
    }
  }

  /* Mobil: horizontales Scroll-Snap wie ein echter Slider */
  @media (max-width: 640px) {
    .news-highlights__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .news-highlights__all:not(.news-highlights__all--mobile) {
      display: none;
    }
    .news-highlights__all--mobile {
      display: inline-flex;
    }

    .news-slides {
      display: flex;
      grid-template-columns: none;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 1rem;
      margin: 0 calc(-1 * var(--container-pad, 1.25rem));
      padding-left: var(--container-pad, 1.25rem);
      padding-right: var(--container-pad, 1.25rem);
      scrollbar-width: thin;
    }
    .news-slide {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
    .news-slide:nth-child(3) {
      grid-column: auto;
      display: block;
    }
    .news-slide:nth-child(3) .news-slide__link {
      display: flex;
      flex-direction: column;
    }
    .news-slide:nth-child(3) .news-slide__media {
      aspect-ratio: 16 / 10;
    }
  }
</style>
