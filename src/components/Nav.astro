---
const base = import.meta.env.BASE_URL;
const isNewsPage = Astro.url.pathname.replace(/\/$/, '') === `${base}news`.replace(/\/$/, '')
  || Astro.url.pathname.startsWith(`${base}news/`);
---

<nav class="nav">
  <div class="nav__inner container">
    <a href={base} class="nav__logo" aria-label="MTX-Webdesign Startseite">
      <img src={`${base}brand/mtx-logo.png`} alt="MTX-Webdesign" class="nav__logo-img" />
    </a>

    <ul class="nav__links">
      <li><a href={`${base}#leistungen`} class="nav__link">Leistungen</a></li>
      <li><a href={`${base}#ablauf`} class="nav__link">Ablauf</a></li>
      <li><a href={`${base}#faq`} class="nav__link">Häufig gefragt</a></li>
      <li>
        <a href={`${base}news/`} class:list={['nav__link', isNewsPage && 'nav__link--active']}>News</a>
      </li>
    </ul>

    <a href={`${base}#kontakt`} class="btn nav__cta">
      <span>Kontakt</span>
      <svg class="btn__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6"/>
      </svg>
    </a>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    gap: 2rem;
  }

  .nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .nav__logo-img {
    display: block;
    height: 52px;
    width: auto;
    object-fit: contain;
    /* Mockup-Wall via multiply teilweise ausblenden, bis wir eine saubere
       transparente Logodatei haben */
    mix-blend-mode: multiply;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav__link {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-2);
    position: relative;
    padding: 4px 0;
    transition: color var(--dur) var(--ease-out);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 100%;
    background: var(--brass);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }

  .nav__link:hover {
    color: var(--ink);
  }

  .nav__link:hover::after,
  .nav__link--active::after {
    transform: scaleX(1);
  }

  .nav__link--active {
    color: var(--ink);
  }

  .nav__cta {
    padding: 0.55rem 1rem;
    font-size: 14px;
  }

  @media (max-width: 780px) {
    .nav__links {
      display: none;
    }
    .nav__inner {
      height: 60px;
    }
  }
</style>
